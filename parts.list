# The parts of esimv1 that live in their own repositories, and the version of each this hub is
# built against. deploy/parts.sh clones any that are missing and links scenario projects into
# projects/. Columns: folder here, repository on GitHub, version (a tag), then for a scenario
# repository its project folders and where each sits under projects/.
core                          anselm/esimv1-core          v0.3.0
viewer                        anselm/esimv1-viewer        v0.3.0
scenarios/esimv1-palisades    anselm/esimv1-palisades     v0.1.0   palisades-2025=anselm/palisades-2025 palisades-cells=anselm/palisades-cells palisades-wired=anselm/palisades-wired
scenarios/esimv1-portland     anselm/esimv1-portland      v0.1.0   portland-cascadia=anselm/portland-cascadia
scenarios/esimv1-earth2100    anselm/esimv1-earth2100     v0.1.0   planet-2100=anselm/planet-2100
